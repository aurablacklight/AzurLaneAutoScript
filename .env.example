# AI provider key for the `sidecar` service in docker-compose.yml (gacha-server).
# The sidecar does not start without a key. The endpoint and the model are set in
# deploy/docker/gacha-server.toml.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# OPENROUTER_API_KEY is also accepted, for either provider.
# OPENROUTER_API_KEY=your-openrouter-api-key-here

# Sidecar files on the host. These are the defaults.
# GACHA_SERVER_CONFIG=./deploy/docker/gacha-server.toml
# GACHA_OCR_MODELS=./models/ocr

# Emulator Configuration
# EMULATOR_SERIAL=host.docker.internal:5555
